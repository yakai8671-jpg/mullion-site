{
  "id": "reddi2ch.app",
  "label": "reddi2ch.item.app",
  "icon": "reddit",
  "standalone": true,
  "permissions": [
    "layout:place",
    "window:write",
    "reddit:read",
    "ollama:run",
    "threadstore:access"
  ],
  "properties": {
    "current": {
      "label": "reddi2ch.prop.permalink",
      "type": "string",
      "default": ""
    },
    "translated": {
      "label": "reddi2ch.prop.translated",
      "type": "boolean",
      "default": false
    },
    "board": {
      "label": "reddi2ch.prop.board",
      "type": "ref",
      "itemType": "reddi2ch.board",
      "link": true
    },
    "thread": {
      "label": "reddi2ch.prop.thread",
      "type": "ref",
      "itemType": "reddi2ch.thread",
      "link": true
    },
    "nameMode": {
      "label": "reddi2ch.prop.nameMode",
      "type": "enum",
      "default": "author",
      "options": [
        "author",
        "anon"
      ]
    },
    "anonName": {
      "label": "reddi2ch.prop.anonName",
      "type": "string",
      "default": "名無しさん@お腹いっぱい。"
    },
    "idScope": {
      "label": "reddi2ch.prop.idScope",
      "type": "enum",
      "default": "subreddit",
      "options": [
        "subreddit",
        "thread"
      ]
    },
    "dropAutoModerator": {
      "label": "reddi2ch.prop.dropAutoModerator",
      "type": "boolean",
      "default": true
    },
    "dropDeleted": {
      "label": "reddi2ch.prop.dropDeleted",
      "type": "boolean",
      "default": false
    },
    "useMinScore": {
      "label": "reddi2ch.prop.useMinScore",
      "type": "boolean",
      "default": false
    },
    "minScore": {
      "label": "reddi2ch.prop.minScore",
      "type": "number",
      "min": -10000,
      "max": 100000,
      "default": 1
    },
    "maxRes": {
      "label": "reddi2ch.prop.maxRes",
      "type": "number",
      "min": 0,
      "max": 5000,
      "default": 0
    },
    "order": {
      "label": "reddi2ch.prop.order",
      "type": "enum",
      "default": "time",
      "options": [
        "time",
        "thread"
      ]
    },
    "highlight": {
      "label": "reddi2ch.prop.highlight",
      "type": "boolean",
      "default": true
    },
    "showImages": {
      "label": "reddi2ch.prop.showImages",
      "type": "boolean",
      "default": true
    },
    "translateStyle": {
      "label": "reddi2ch.prop.translateStyle",
      "type": "reddi2ch.style",
      "default": ""
    },
    "translateMax": {
      "label": "reddi2ch.prop.translateMax",
      "type": "number",
      "min": 0,
      "max": 5000,
      "default": 30
    }
  },
  "screen": "reddi2ch.app",
  "derived": {
    "facts": {
      "label": "reddi2ch.section.state",
      "type": "data",
      "from": {
        "script": "appFacts"
      }
    },
    "tiles": {
      "label": "reddi2ch.section.windows",
      "type": "data",
      "from": {
        "script": "appTiles"
      }
    }
  },
  "actions": {
    "again": {
      "use": "reddi2ch.again"
    },
    "show": {
      "use": "reddi2ch.show",
      "inputs": {
        "key": {
          "payload": "key"
        },
        "board": "board",
        "thread": "thread"
      }
    },
    "openview": {
      "use": "open",
      "with": {
        "screen": "reddi2ch.view",
        "share": [
          "nameMode",
          "anonName",
          "idScope",
          "dropAutoModerator",
          "dropDeleted",
          "useMinScore",
          "minScore",
          "maxRes",
          "order",
          "highlight",
          "showImages",
          "translateStyle",
          "translateMax"
        ]
      }
    },
    "opensettings": {
      "use": "open",
      "with": {
        "screen": "reddi2ch.settings"
      }
    }
  }
}
