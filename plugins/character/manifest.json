{
  "id": "character",
  "name": "Character Editor",
  "version": "1.0.0",
  "description": "Edit a character with named references and actions, alongside a live preview.",
  "api": 1,
  "translations": "i18n.json",
  "styles": [
    "character.css"
  ],
  "actions": [
    "actions/save.json",
    "actions/replace.json"
  ],
  "types": [
    "types/reference.json",
    "types/action.json",
    "types/character.json",
    "types/media.json"
  ],
  "controls": [
    "controls/summary.json",
    "controls/card.json",
    "controls/mediainput.json",
    "controls/referencepreview.json",
    "controls/actionpreview.json"
  ],
  "items": [
    "items/editor.json",
    "items/preview.json"
  ],
  "apps": [
