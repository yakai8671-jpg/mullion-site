{
  "id": "pose2img",
  "name": "Pose to Image",
  "version": "1.0.0",
  "description": "A picture drawn from a posed 3D figure: set up a VRM model, a pose and a camera, and the depth of that scene is what the image is generated from. promptmanager's 3D-pose page, with its ComfyUI workflow already in it.",
  "api": 1,
  "translations": "i18n.json",
  "items": [
    "items/app.json",
    "items/scene.json"
  ],
  "apps": [
    "apps/app.json",
    "apps/scene.json"
  ],
  "controls": [
    "controls/viewport.json",
    "controls/scenecard.json"
  ],
  "assets": [
    "assets/anima.json",
    "assets/qwen.json"
  ],
  "scripts": [
    "hooks.js",
    "controls.js"
  ],
  "styles": [
    "pose2img.css"
  ],
  "permissions": [
    "layout:place",
    "comfy:run",
    "ollama:run",
    "store:read",
    "store:write",
    "fs:read",
    "window:write",
    "services:read",
    "services:write"
  ],
  "provides": {
    "itemTypes": [
      "pose2img.app",
      "pose2img.scene"
    ],
    "valueTypes": [],
    "controls": [
      "pose2img.viewport",
      "pose2img.scenecard"
    ],
    "permissions": [],
    "skins": []
  },
  "requires": [
    "workflow",
    "prompt",
    "services"
  ],
  "presets": "presets.json"
}
